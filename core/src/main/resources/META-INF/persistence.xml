<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="conformitaPU" transaction-type="RESOURCE_LOCAL">
        <class>it.frank.conformita.core.entity.Impresa</class>
        <class>it.frank.conformita.core.entity.Pratica</class>
        <class>it.frank.conformita.core.entity.MaterialeRiga</class>
        <class>it.frank.conformita.core.entity.VerificaRiga</class>
        <class>it.frank.conformita.core.entity.UnifilareSchemaLibraryEntry</class>
        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.H2Dialect"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
        </properties>
    </persistence-unit>
</persistence>
