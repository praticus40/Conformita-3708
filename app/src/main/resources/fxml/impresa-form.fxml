<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.frank.conformita.ui.ImpresaPanelController">
    <padding>
        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
    </padding>
    <Label styleClass="placeholder-title" text="Anagrafica impresa" />
    <GridPane hgap="12.0" vgap="12.0">
        <Label text="Ragione sociale" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="ragioneSocialeField" GridPane.columnIndex="1" GridPane.rowIndex="0" />
        <Label text="Partita IVA" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="partitaIvaField" GridPane.columnIndex="1" GridPane.rowIndex="1" />
        <Label text="Sede legale" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextField fx:id="sedeLegaleField" GridPane.columnIndex="1" GridPane.rowIndex="2" />
        <Label text="Legale rappresentante" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <TextField fx:id="legaleRappresentanteField" GridPane.columnIndex="1" GridPane.rowIndex="3" />
        <Label text="REA" GridPane.columnIndex="0" GridPane.rowIndex="4" />
        <TextField fx:id="reaField" GridPane.columnIndex="1" GridPane.rowIndex="4" />
        <Label text="CCIAA n." GridPane.columnIndex="0" GridPane.rowIndex="5" />
        <TextField fx:id="cciaaField" GridPane.columnIndex="1" GridPane.rowIndex="5" />
        <Label text="Responsabile tecnico" GridPane.columnIndex="0" GridPane.rowIndex="6" />
        <TextField fx:id="responsabileTecnicoField" GridPane.columnIndex="1" GridPane.rowIndex="6" />
        <Label text="Telefono" GridPane.columnIndex="0" GridPane.rowIndex="7" />
        <TextField fx:id="telefonoField" GridPane.columnIndex="1" GridPane.rowIndex="7" />
        <Label text="Comune" GridPane.columnIndex="0" GridPane.rowIndex="8" />
        <ComboBox fx:id="comuneCombo" editable="true" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="8" />
        <Label text="Provincia" GridPane.columnIndex="0" GridPane.rowIndex="9" />
        <ComboBox fx:id="provinciaCombo" editable="true" maxWidth="Infinity" promptText="Sigla o nome (es. PA)" GridPane.columnIndex="1" GridPane.rowIndex="9" />
    </GridPane>
    <Button fx:id="salvaButton" text="Salva impresa" />
</VBox>
