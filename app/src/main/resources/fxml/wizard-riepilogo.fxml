<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.frank.conformita.ui.WizardRiepilogoPanelController">
    <padding>
        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
    </padding>
    <Label styleClass="placeholder-title" text="Step 9 — Riepilogo ed export" />
    <Label text="Anteprima sintetica dei dati principali. Usa Validazione ed Esporta PDF dalla barra strumenti." wrapText="true" />
    <TextArea fx:id="summaryArea" editable="false" prefRowCount="12" wrapText="true" VBox.vgrow="ALWAYS" />
    <Button fx:id="btnValida" text="Valida pratica" />
    <Button fx:id="btnEsporta" text="Esporta pacchetto PDF…" />
</VBox>
