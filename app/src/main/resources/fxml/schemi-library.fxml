<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.frank.conformita.ui.SchemiLibraryPanelController">
    <padding>
        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
    </padding>
    <Label styleClass="placeholder-title" text="Libreria schemi unifilari" />
    <HBox spacing="8.0">
        <Button fx:id="btnNew" text="Nuovo…" />
        <Button fx:id="btnDuplicate" text="Duplica…" />
        <Button fx:id="btnDelete" text="Elimina" />
        <Button fx:id="btnOpenEditor" text="Apri editor…" />
    </HBox>
    <TableView fx:id="schemaTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colName" prefWidth="320.0" text="Nome" />
            <TableColumn fx:id="colUpdated" prefWidth="180.0" text="Aggiornato" />
        </columns>
    </TableView>
</VBox>
