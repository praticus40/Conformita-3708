<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.frank.conformita.ui.WizardCommittentePanelController">
    <padding>
        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
    </padding>
    <Label styleClass="placeholder-title" text="Step 2 — Committente e ubicazione" />
    <GridPane hgap="12.0" vgap="12.0">
        <Label text="Provincia impianto" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <ComboBox fx:id="provinciaCombo" editable="true" maxWidth="Infinity" promptText="Sigla o nome (es. PA)" GridPane.columnIndex="1" GridPane.rowIndex="0" />
        <Label text="Comune impianto" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <ComboBox fx:id="comuneImpiantoCombo" editable="true" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1" />
        <Label text="Committente" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextField fx:id="committenteNomeField" GridPane.columnIndex="1" GridPane.rowIndex="2" />
        <Label text="Codice fiscale" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <TextField fx:id="codiceFiscaleField" GridPane.columnIndex="1" GridPane.rowIndex="3" />
        <Label text="Indirizzo committente" GridPane.columnIndex="0" GridPane.rowIndex="4" />
        <TextField fx:id="indirizzoCommittenteField" GridPane.columnIndex="1" GridPane.rowIndex="4" />
        <Label text="Indirizzo impianto" GridPane.columnIndex="0" GridPane.rowIndex="5" />
        <TextField fx:id="indirizzoField" GridPane.columnIndex="1" GridPane.rowIndex="5" />
        <Label text="Comune" GridPane.columnIndex="0" GridPane.rowIndex="6" />
        <ComboBox fx:id="comuneCombo" editable="true" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="6" />
        <Label text="CAP" GridPane.columnIndex="0" GridPane.rowIndex="7" />
        <TextField fx:id="capField" GridPane.columnIndex="1" GridPane.rowIndex="7" />
        <Label text="Proprietario / descrizione" GridPane.columnIndex="0" GridPane.rowIndex="8" />
        <TextArea fx:id="proprietarioArea" prefRowCount="2" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="8" />
    </GridPane>
</VBox>
