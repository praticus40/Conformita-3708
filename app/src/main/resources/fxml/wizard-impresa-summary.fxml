<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.frank.conformita.ui.WizardImpresaPanelController">
    <padding>
        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
    </padding>
    <Label styleClass="placeholder-title" text="Step 1 — Anagrafica impresa" />
    <Label fx:id="warningLabel" wrapText="true" />
    <GridPane hgap="12.0" vgap="8.0">
        <Label text="Ragione sociale" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <Label fx:id="ragioneSocialeLabel" GridPane.columnIndex="1" GridPane.rowIndex="0" />
        <Label text="Partita IVA" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <Label fx:id="partitaIvaLabel" GridPane.columnIndex="1" GridPane.rowIndex="1" />
        <Label text="Sede legale" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <Label fx:id="sedeLegaleLabel" GridPane.columnIndex="1" GridPane.rowIndex="2" />
    </GridPane>
    <Button fx:id="vaiImpresaButton" text="Vai a Impresa" />
</VBox>
