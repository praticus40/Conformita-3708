<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.frank.conformita.ui.WizardMaterialiPanelController">
    <padding>
        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
    </padding>
    <Label styleClass="placeholder-title" text="Step 6 — Relazione tipologica materiali" />
    <HBox spacing="8.0">
        <Button fx:id="btnAggiungi" text="Aggiungi riga" />
        <Button fx:id="btnRimuovi" text="Rimuovi selezionata" />
    </HBox>
    <TableView fx:id="materialiTable" editable="true" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colDescrizione" prefWidth="200.0" text="Descrizione" />
            <TableColumn fx:id="colMarchio" prefWidth="120.0" text="Marchio" />
            <TableColumn fx:id="colModello" prefWidth="120.0" text="Modello" />
            <TableColumn fx:id="colPosa" prefWidth="100.0" text="Posa" />
            <TableColumn fx:id="colSigla" prefWidth="80.0" text="Sigla" />
        </columns>
    </TableView>
</VBox>
