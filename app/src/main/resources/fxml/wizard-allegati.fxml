<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.frank.conformita.ui.WizardLibrettoPanelController">
    <padding>
        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
    </padding>
    <Label styleClass="placeholder-title" text="Step 8 — Libretto uso/manutenzione e schemi" />
    <GridPane hgap="12.0" vgap="12.0">
        <Label text="Telefono assistenza" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="telefonoAssistenzaField" GridPane.columnIndex="1" GridPane.rowIndex="0" />
        <Label text="Schema da libreria" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
            <ComboBox fx:id="schemaLibraryCombo" prefWidth="360.0" promptText="Seleziona schema…" />
            <Label fx:id="schemaLibraryStatusLabel" text="Schema libreria: —" />
            <Label fx:id="schemaPdfStatusLabel" text="PDF export: —" />
            <Label text="Modifica gli schemi dal menu Schemi → Apri editor." wrapText="true" />
        </VBox>
        <Label text="Schema allegato (PDF)" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <HBox spacing="8.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
            <TextField fx:id="schemaPathField" editable="false" HBox.hgrow="ALWAYS" />
            <Button fx:id="btnScegliSchema" text="Importa PDF…" />
        </HBox>
    </GridPane>
</VBox>
